{
  "name": "relex",
  "version": "0.1.0",
  "description": "Stand-up and stretch reminder for developers",
  "main": "./out/main/index.js",
  "author": "rakiibull",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "unset ELECTRON_RUN_AS_NODE && electron-vite dev",
    "build": "electron-vite build",
    "pack:mac": "npm run build && unset ELECTRON_RUN_AS_NODE && electron-builder --mac --x64 --dir",
    "dist:mac": "npm run build && unset ELECTRON_RUN_AS_NODE && electron-builder --mac --x64",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "release": "node scripts/release.js",
    "schedule": "node scripts/schedule.js"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "43.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.7.0",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "electron-store": "^11.0.2"
  }
}
